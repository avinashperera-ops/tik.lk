datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum CommitteeRole {
  OWNER
  MANAGER
  FINANCE
  MARKETING
  SCANNER_STAFF
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  PAID
  CHECKED_IN
  TRANSFERRED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DynamicPricingType {
  TIME_BASED
  CAPACITY_BASED
}

enum AccessZoneType {
  GATE
  VIP_LOUNGE
  BACKSTAGE
  GENERAL
}

enum PaymentMethod {
  CREDIT_CARD
  INSTANT_PAYMENT
  CASH
}

model User {
  id               String            @id @default(uuid())
  externalAuthId   String?           @unique
  email            String            @unique
  fullName         String?
  phoneNumber      String?
  avatarUrl        String?
  globalRole       GlobalRole        @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  committeeMembers CommitteeMember[]
  purchasedTickets Ticket[]          @relation("TicketOwner")
  transactions     Transaction[]
  gateLogs         GateLog[]         @relation("ScannerStaff")
  auditLogs        AuditLog[]
  affiliateLinks   AffiliateLink[]
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  logoUrl          String?
  description      String?
  stripeAccountId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          CommitteeMember[]
  events           Event[]
}

model CommitteeMember {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           CommitteeRole @default(MANAGER)
  createdAt      DateTime      @default(now())

  @@unique([userId, organizationId])
}

model Event {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String              @unique
  description    String
  venueName      String
  venueAddress   String
  bannerImageUrl String?
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean             @default(false)
  allowResale    Boolean             @default(true)
  maxResalePrice Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  customization  EventCustomization?
  ticketTiers    TicketTier[]
  discounts      DiscountRule[]
  tickets        Ticket[]
  gateLogs       GateLog[]
  seats          Seat[]
  zones          AccessZone[]
  campaigns      BroadcastCampaign[]
  affiliates     AffiliateLink[]
}

model EventCustomization {
  id             String   @id @default(uuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("#ffffff")
  accentColor    String   @default("#6366f1")
  fontFamily     String   @default("Inter")
  customCss      String?
  heroLayout     String   @default("MODERN_FULL")
  enableWaitlist Boolean  @default(false)
  passDesignConfig Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DynamicPricingRule {
  id             String             @id @default(uuid())
  tierId         String
  tier           TicketTier         @relation(fields: [tierId], references: [id], onDelete: Cascade)
  ruleType       DynamicPricingType
  triggerTime    DateTime?
  triggerPercent Int?
  adjustedPrice  Int
  createdAt      DateTime           @default(now())
}

model TicketTier {
  id             String               @id @default(uuid())
  eventId        String
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceInCents   Int
  totalCapacity  Int
  availableCount Int
  maxPerUser     Int                  @default(5)
  isRecurring    Boolean              @default(false)
  validDates     DateTime[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tickets        Ticket[]
  discounts      DiscountRule[]
  pricingRules   DynamicPricingRule[]

  @@index([eventId])
}

model Seat {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section   String
  row       String
  number    String
  isReserved Boolean @default(false)
  reservedAt DateTime?
  ticket    Ticket?

  @@unique([eventId, section, row, number])
}

model DiscountRule {
  id           String       @id @default(uuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code         String
  discountType DiscountType
  value        Int
  maxUses      Int?
  currentUses  Int          @default(0)
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime     @default(now())

  ticketTiers  TicketTier[]

  @@unique([eventId, code])
}

model Ticket {
  id            String       @id @default(uuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  tierId        String
  tier          TicketTier   @relation(fields: [tierId], references: [id])
  seatId        String?      @unique
  seat          Seat?        @relation(fields: [seatId], references: [id])
  ownerId       String?
  owner         User?        @relation("TicketOwner", fields: [ownerId], references: [id])
  status        TicketStatus @default(AVAILABLE)
  qrPayload     String?      @unique
  reservedUntil DateTime?
  metadata      Json?
  version       Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  gateLogs      GateLog[]

  @@index([eventId, status])
  @@index([tierId, status])
  @@index([ownerId])
}

model Transaction {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amountInCents  Int
  platformFee    Int           @default(0)
  taxAmount      Int           @default(0)
  currency       String        @default("USD")
  gateway        String
  gatewayTxId    String        @unique
  paymentMethod  PaymentMethod @default(CREDIT_CARD)
  status         String
  createdAt      DateTime      @default(now())

  tickets        Ticket[]
}

model AccessZone {
  id        String         @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  type      AccessZoneType @default(GATE)

  gateLogs  GateLog[]
}

model GateLog {
  id            String     @id @default(uuid())
  ticketId      String
  ticket        Ticket     @relation(fields: [ticketId], references: [id])
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id])
  zoneId        String?
  zone          AccessZone? @relation(fields: [zoneId], references: [id])
  scannedById   String
  scannedBy     User       @relation("ScannerStaff", fields: [scannedById], references: [id])
  scanResult    String
  failureReason String?
  scannedAt     DateTime   @default(now())

  @@index([ticketId])
  @@index([eventId])
}

model BroadcastCampaign {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  targetTier String?
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
}

model AffiliateLink {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoterId   String
  promoter     User     @relation(fields: [promoterId], references: [id])
  code         String   @unique
  commissionPct Int
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  targetEntity   String
  targetEntityId String
  metadata       Json?
  createdAt      DateTime @default(now())
}